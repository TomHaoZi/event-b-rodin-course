    <org.eventb.core.guard name="guard4" org.eventb.core.label="room" org.eventb.core.predicate="balance(a_of_trans(t))+q_of_trans(t) ∈ 0‥c" org.eventb.core.theorem="false" />
    <org.eventb.core.witness name="witness1" org.eventb.core.label="a" org.eventb.core.predicate="a = a_of_trans(t)" />
