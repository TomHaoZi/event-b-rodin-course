  <org.eventb.core.event name="event6" org.eventb.core.label="move1" org.eventb.core.convergence="0" org.eventb.core.extended="true">
    <org.eventb.core.refinesEvent name="refinesEvent1" org.eventb.core.target="withdraw" />
    <org.eventb.core.parameter name="parameter1" org.eventb.core.identifier="b" />
    <org.eventb.core.parameter name="parameter2" org.eventb.core.identifier="t" />
    <org.eventb.core.guard name="guard1" org.eventb.core.label="destOpen" org.eventb.core.predicate="b ∈ account" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="guard2" org.eventb.core.label="distinct" org.eventb.core.predicate="b ≠ a" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="guard3" org.eventb.core.label="fresh" org.eventb.core.predicate="t ∈ T ∖ trans" org.eventb.core.theorem="false" />
    <org.eventb.core.action name="action1" org.eventb.core.label="recordTrans" org.eventb.core.assignment="trans ≔ trans ∪ {t}" />
