  <org.eventb.core.axiom name="axiom1" org.eventb.core.label="axm3_1" org.eventb.core.predicate="SENSOR = {on, off}" org.eventb.core.theorem="false" />
  <org.eventb.core.axiom name="axiom2" org.eventb.core.label="axm3_2" org.eventb.core.predicate="on ≠ off" org.eventb.core.theorem="false" />
  <org.eventb.core.axiom name="axiom3" org.eventb.core.label="phase_type" org.eventb.core.predicate="phase ∈ (SENSOR × BOOL) → ℕ" org.eventb.core.theorem="false" />
  <org.eventb.core.axiom name="axiom4" org.eventb.core.label="phase_idle" org.eventb.core.predicate="phase(off ↦ FALSE) = 2" org.eventb.core.theorem="false" />
